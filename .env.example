# Copy to .env.local for local dev (npm run dev / npm run preview run the api/ functions too).
# On Vercel, add these under Project → Settings → Environment Variables. Every one is optional:
# a missing key switches that feature off and the site falls back gracefully.

# Shadow clone chat, Scouter and contact triage (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Hard ceiling on AI calls per day across all visitors (default 400)
# AI_DAILY_LIMIT=400

# Live counters, rate limits and the contact inbox. Added for you by the Upstash Redis
# integration in Vercel → Storage (either naming works).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Contact form email (resend.com → API keys)
RESEND_API_KEY=
# CONTACT_TO=siddhantvashisth05@gmail.com
# After verifying a domain in Resend, send from it, e.g. "Siddhant <hello@yourdomain.com>"
# CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Optional instant ping for every new message (Discord or Slack incoming webhook URL)
# NOTIFY_WEBHOOK_URL=

# Private inbox at /api/inbox?key=… (any long random string, 16+ characters)
ADMIN_TOKEN=

# Optional: raises the GitHub API limit for the "Live from GitHub" feed
# GITHUB_TOKEN=

# Optional: canonical/OG URL for a custom domain
# VITE_SITE_URL=https://yourdomain.com
